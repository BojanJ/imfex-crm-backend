# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-north-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-north-1.pooler.supabase.com:5432/postgres

# Authentication (REQUIRED in production, min 32 chars — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=
# Optional token lifetime in seconds (default: 43200 = 12 hours)
JWT_EXPIRES_IN_SECONDS=43200

# Transactional Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="IMFEX CRM <onboarding@resend.dev>"

# Optional: Supabase Object Storage for Client/Project Documents (API-04)
# Create a private bucket named "client-documents" in Supabase -> Storage
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=client-documents

# Optional: Additional allowed CORS origins (localhost:3000 and imfex-crm-frontend*.vercel.app are already allowed)
FRONTEND_URL=
ALLOWED_ORIGINS=

# Optional: Enable /api/admin/clean-database and /api/admin/reset-database in production (keep false/unset!)
ALLOW_ADMIN_DB_TOOLS=false

# Optional: Initial password used by `npm run db:seed` (if omitted, a random one-time password is generated)
ADMIN_SEED_PASSWORD=
