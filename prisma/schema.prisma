// Prisma Schema for IMFEX CRM
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  USER
}

enum SpecInputType {
  SELECT
  MULTISELECT
  TEXT
  NUMBER
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
  PARTNER
  OTHER
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ProjectStatus {
  PLANNED
  PROCUREMENT
  PRODUCTION
  INSTALLATION
  COMPLETED
  CLOSED
}

enum ServicePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ServiceStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CLOSED
}

model Profile {
  id                 String          @id @default(uuid()) @db.Uuid
  email              String          @unique
  fullName           String?         @map("full_name")
  passwordHash       String?         @map("password_hash")
  mustChangePassword Boolean         @default(true) @map("must_change_password")
  status             String          @default("ACTIVE")
  role               UserRole        @default(USER)
  createdAt          DateTime        @default(now()) @map("created_at")
  offers              Offer[]
  managedProjects     Project[]            @relation("ProjectResponsible")
  assignedServices    ServiceTicket[]      @relation("ServiceTechnician")
  passwordResetTokens PasswordResetToken[]

  @@map("profiles")
}

model ProductCategory {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  parentId  String?           @map("parent_id") @db.Uuid
  parent    ProductCategory?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children  ProductCategory[] @relation("CategoryToCategory")
  createdAt DateTime          @default(now()) @map("created_at")
  products  Product[]

  @@index([parentId])
  @@map("product_categories")
}

model Product {
  id                String             @id @default(uuid()) @db.Uuid
  categoryId        String?            @map("category_id") @db.Uuid
  category          ProductCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name              String
  code              String             @unique
  description       String?
  isActive          Boolean            @default(true) @map("is_active")
  stockType         String             @default("STOCK") @map("stock_type")
  stockQuantity     Int                @default(0) @map("stock_quantity")
  reservedQuantity  Int                @default(0) @map("reserved_quantity")
  purchasePrice     Decimal            @default(0.00) @map("purchase_price") @db.Decimal(10, 2)
  createdAt         DateTime           @default(now()) @map("created_at")
  models            ProductModel[]
  specificationKeys SpecificationKey[]
  offerItems        OfferItem[]
  installedItems    InstalledItem[]

  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

model ProductModel {
  id         String      @id @default(uuid()) @db.Uuid
  productId  String      @map("product_id") @db.Uuid
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  basePrice  Decimal     @default(0.00) @map("base_price") @db.Decimal(10, 2)
  createdAt  DateTime    @default(now()) @map("created_at")
  offerItems OfferItem[]

  @@index([productId])
  @@map("product_models")
}

model SpecificationKey {
  id                      String                   @id @default(uuid()) @db.Uuid
  productId               String                   @map("product_id") @db.Uuid
  product                 Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name                    String
  inputType               SpecInputType            @default(SELECT) @map("input_type")
  defaultValue            String?                  @map("default_value")
  createdAt               DateTime                 @default(now()) @map("created_at")
  options                 SpecificationOption[]
  offerItemSpecifications OfferItemSpecification[]

  @@index([productId])
  @@map("specification_keys")
}

model SpecificationOption {
  id                      String                   @id @default(uuid()) @db.Uuid
  specificationKeyId      String                   @map("specification_key_id") @db.Uuid
  specificationKey        SpecificationKey         @relation(fields: [specificationKeyId], references: [id], onDelete: Cascade)
  label                   String
  priceModifier           Decimal                  @default(0.00) @map("price_modifier") @db.Decimal(10, 2)
  isDefault               Boolean                  @default(false) @map("is_default")
  createdAt               DateTime                 @default(now()) @map("created_at")
  offerItemSpecifications OfferItemSpecification[]

  @@index([specificationKeyId])
  @@map("specification_options")
}

model Customer {
  id             String          @id @default(uuid()) @db.Uuid
  customerType   CustomerType    @default(INDIVIDUAL) @map("customer_type")
  name           String
  companyName    String?         @map("company_name")
  taxId          String?         @map("tax_id")
  email          String?
  phone          String?
  address        String?
  city           String?
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  offers         Offer[]
  projects       Project[]
  documents      ClientDocument[]
  installedItems InstalledItem[]
  serviceTickets ServiceTicket[]
  calendarEvents CalendarEvent[]

  @@map("customers")
}

model Offer {
  id              String      @id @default(uuid()) @db.Uuid
  offerNumber     String      @unique @map("offer_number")
  customerId      String      @map("customer_id") @db.Uuid
  customer        Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdByUserId String?     @map("created_by_user_id") @db.Uuid
  createdByUser   Profile?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  status          OfferStatus @default(DRAFT)
  taxRate         Decimal     @default(18.00) @map("tax_rate") @db.Decimal(5, 2)
  discountRate    Decimal     @default(0.00) @map("discount_rate") @db.Decimal(5, 2)
  discountAmount  Decimal     @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  subtotal        Decimal     @default(0.00) @db.Decimal(10, 2)
  taxAmount       Decimal     @default(0.00) @map("tax_amount") @db.Decimal(10, 2)
  totalAmount     Decimal     @default(0.00) @map("total_amount") @db.Decimal(10, 2)
  validUntil      DateTime?   @map("valid_until") @db.Date
  createdAt       DateTime    @default(now()) @map("created_at")
  items           OfferItem[]
  project         Project?
  documents       ClientDocument[]

  @@index([customerId])
  @@index([status])
  @@index([createdByUserId])
  @@map("offers")
}

model OfferItem {
  id                      String                   @id @default(uuid()) @db.Uuid
  offerId                 String                   @map("offer_id") @db.Uuid
  offer                   Offer                    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  serviceTypes            String[]                 @map("service_types")
  productId               String?                  @map("product_id") @db.Uuid
  product                 Product?                 @relation(fields: [productId], references: [id], onDelete: SetNull)
  productModelId          String?                  @map("product_model_id") @db.Uuid
  productModel            ProductModel?            @relation(fields: [productModelId], references: [id], onDelete: SetNull)
  customTitle             String?                  @map("custom_title")
  widthMm                 Int?                     @map("width_mm")
  heightMm                Int?                     @map("height_mm")
  quantity                Int                      @default(1)
  unitPrice               Decimal                  @default(0.00) @map("unit_price") @db.Decimal(10, 2)
  totalPrice              Decimal                  @default(0.00) @map("total_price") @db.Decimal(10, 2)
  createdAt               DateTime                 @default(now()) @map("created_at")
  offerItemSpecifications OfferItemSpecification[]

  @@index([offerId])
  @@index([productId])
  @@map("offer_items")
}

model OfferItemSpecification {
  id                    String               @id @default(uuid()) @db.Uuid
  offerItemId           String               @map("offer_item_id") @db.Uuid
  offerItem             OfferItem            @relation(fields: [offerItemId], references: [id], onDelete: Cascade)
  specificationKeyId    String?              @map("specification_key_id") @db.Uuid
  specificationKey      SpecificationKey?    @relation(fields: [specificationKeyId], references: [id], onDelete: SetNull)
  specificationOptionId String?              @map("specification_option_id") @db.Uuid
  specificationOption   SpecificationOption? @relation(fields: [specificationOptionId], references: [id], onDelete: SetNull)
  customValue           String?              @map("custom_value")
  customKeyName         String?              @map("custom_key_name")
  customPriceModifier   Decimal?             @default(0.00) @map("custom_price_modifier") @db.Decimal(10, 2)
  createdAt             DateTime             @default(now()) @map("created_at")

  @@index([offerItemId])
  @@index([specificationKeyId])
  @@index([specificationOptionId])
  @@map("offer_item_specifications")
}

model Project {
  id                   String        @id @default(uuid()) @db.Uuid
  projectNumber        String        @unique @map("project_number")
  offerId              String        @unique @map("offer_id") @db.Uuid
  offer                Offer         @relation(fields: [offerId], references: [id], onDelete: Restrict)
  customerId           String        @map("customer_id") @db.Uuid
  customer             Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  responsibleUserId    String?       @map("responsible_user_id") @db.Uuid
  responsibleUser      Profile?      @relation("ProjectResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  status               ProjectStatus @default(PLANNED)
  startDate            DateTime?     @map("start_date") @db.Date
  targetDeliveryDate   DateTime?     @map("target_delivery_date") @db.Date
  actualDeliveryDate   DateTime?     @map("actual_delivery_date") @db.Date
  procurementStatus    String?       @map("procurement_status")
  procurementNotes     String?       @map("procurement_notes")
  installationTeam     String?       @map("installation_team")
  installationDate     DateTime?     @map("installation_date") @db.Date
  installationAddress  String?       @map("installation_address")
  installationContact  String?       @map("installation_contact")
  installationMinutes  String?       @map("installation_minutes")
  signatureUrl         String?       @map("signature_url")
  workflowData         Json?         @map("workflow_data")
  createdAt            DateTime      @default(now()) @map("created_at")
  documents            ClientDocument[]
  installedItems       InstalledItem[]

  @@index([customerId])
  @@index([status])
  @@index([responsibleUserId])
  @@map("projects")
}

model InstalledItem {
  id               String          @id @default(uuid()) @db.Uuid
  customerId       String          @map("customer_id") @db.Uuid
  customer         Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  projectId        String?         @map("project_id") @db.Uuid
  project          Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  productId        String?         @map("product_id") @db.Uuid
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  title            String
  serialNumber     String?         @map("serial_number")
  installationDate DateTime        @default(now()) @map("installation_date")
  serviceTickets   ServiceTicket[]

  @@index([customerId])
  @@index([projectId])
  @@index([productId])
  @@map("installed_items")
}

model ServiceTicket {
  id                   String          @id @default(uuid()) @db.Uuid
  ticketNumber         String          @unique @map("ticket_number")
  customerId           String          @map("customer_id") @db.Uuid
  customer             Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  installedItemId      String?         @map("installed_item_id") @db.Uuid
  installedItem        InstalledItem?  @relation(fields: [installedItemId], references: [id], onDelete: SetNull)
  defectDescription    String          @map("defect_description")
  priority             ServicePriority @default(MEDIUM)
  status               ServiceStatus   @default(OPEN)
  assignedTechnicianId String?         @map("assigned_technician_id") @db.Uuid
  assignedTechnician   Profile?        @relation("ServiceTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  scheduledDate        DateTime?       @map("scheduled_date")
  partsConsumed        Json?           @map("parts_consumed")
  laborHours           Decimal         @default(0.00) @map("labor_hours") @db.Decimal(5, 2)
  solution             String?
  closedAt             DateTime?       @map("closed_at")
  createdAt            DateTime        @default(now()) @map("created_at")
  documents            ClientDocument[]

  @@index([customerId])
  @@index([status])
  @@index([priority])
  @@index([assignedTechnicianId])
  @@map("service_tickets")
}

model ClientDocument {
  id          String         @id @default(uuid()) @db.Uuid
  customerId  String         @map("customer_id") @db.Uuid
  customer    Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  offerId     String?        @map("offer_id") @db.Uuid
  offer       Offer?         @relation(fields: [offerId], references: [id], onDelete: SetNull)
  projectId   String?        @map("project_id") @db.Uuid
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  serviceId   String?        @map("service_id") @db.Uuid
  service     ServiceTicket? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  title       String
  fileType    String         @map("file_type")
  fileUrl     String         @map("file_url")
  fileName    String?        @map("file_name")
  sizeBytes   Int?           @map("size_bytes")
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([customerId])
  @@index([projectId])
  @@index([offerId])
  @@index([serviceId])
  @@map("client_documents")
}

model CalendarEvent {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  description String?
  startDate   String    @map("start_date")
  endDate     String?   @map("end_date")
  allDay      Boolean   @default(false) @map("all_day")
  eventType   String    @default("MEETING") @map("event_type")
  customerId  String?   @map("customer_id") @db.Uuid
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  projectId   String?   @map("project_id")
  location    String?
  color       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([customerId])
  @@index([projectId])
  @@index([startDate])
  @@map("calendar_events")
}

model PurchaseInvoice {
  id                    String   @id
  internalNumber        String   @unique @map("internal_number")
  supplierInvoiceNumber String?  @map("supplier_invoice_number")
  supplierId            String   @map("supplier_id")
  supplierName          String   @map("supplier_name")
  projectId             String?  @map("project_id")
  offerId               String?  @map("offer_id")
  issueDate             String   @map("issue_date")
  dueDate               String?  @map("due_date")
  status                String   @default("INVOICED")
  receiptStatus         String   @default("PENDING") @map("receipt_status")
  taxRate               Decimal  @default(18.00) @map("tax_rate") @db.Decimal(5, 2)
  subtotal              Decimal  @default(0.00) @db.Decimal(12, 2)
  taxAmount             Decimal  @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount           Decimal  @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  paidAmount            Decimal  @default(0.00) @map("paid_amount") @db.Decimal(12, 2)
  notes                 String?
  items                 Json     @default("[]")
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@index([status])
  @@map("purchase_invoices")
}

model SalesInvoice {
  id                         String   @id
  invoiceNumber              String   @unique @map("invoice_number")
  externalAccountingNumber   String?  @map("external_accounting_number")
  invoiceType                String   @map("invoice_type")
  status                     String   @default("ISSUED")
  customerId                 String   @map("customer_id")
  offerId                    String?  @map("offer_id")
  projectId                  String?  @map("project_id")
  issueDate                  String   @map("issue_date")
  dueDate                    String?  @map("due_date")
  taxRate                    Decimal  @default(18.00) @map("tax_rate") @db.Decimal(5, 2)
  discountRate               Decimal  @default(0.00) @map("discount_rate") @db.Decimal(5, 2)
  discountAmount             Decimal  @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  subtotal                   Decimal  @default(0.00) @db.Decimal(12, 2)
  taxAmount                  Decimal  @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  grossTotalAmount           Decimal  @default(0.00) @map("gross_total_amount") @db.Decimal(12, 2)
  linkedAdvanceInvoiceId     String?  @map("linked_advance_invoice_id")
  linkedAdvanceInvoiceNumber String?  @map("linked_advance_invoice_number")
  advanceDeductedAmount      Decimal  @default(0.00) @map("advance_deducted_amount") @db.Decimal(12, 2)
  totalAmount                Decimal  @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  paidAmount                 Decimal  @default(0.00) @map("paid_amount") @db.Decimal(12, 2)
  notes                      String?
  items                      Json     @default("[]")
  createdAt                  DateTime @default(now()) @map("created_at")

  @@index([customerId])
  @@index([projectId])
  @@index([offerId])
  @@index([status])
  @@map("sales_invoices")
}

model DispatchNote {
  id              String   @id
  dispatchNumber  String   @unique @map("dispatch_number")
  status          String   @default("DRAFT")
  customerId      String   @map("customer_id")
  projectId       String?  @map("project_id")
  offerId         String?  @map("offer_id")
  salesInvoiceId  String?  @map("sales_invoice_id")
  issueDate       String   @map("issue_date")
  deliveryAddress String?  @map("delivery_address")
  receivedBy      String?  @map("received_by")
  issuedBy        String?  @map("issued_by")
  notes           String?
  items           Json     @default("[]")
  stockDeducted   Boolean  @default(false) @map("stock_deducted")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([customerId])
  @@index([projectId])
  @@map("dispatch_notes")
}

model PaymentRecord {
  id                String   @id
  paymentNumber     String   @unique @map("payment_number")
  direction         String
  amount            Decimal  @default(0.00) @db.Decimal(12, 2)
  date              String
  method            String   @default("BANK")
  bankAccount       String?  @map("bank_account")
  customerId        String?  @map("customer_id")
  partnerName       String?  @map("partner_name")
  projectId         String?  @map("project_id")
  offerId           String?  @map("offer_id")
  salesInvoiceId    String?  @map("sales_invoice_id")
  purchaseInvoiceId String?  @map("purchase_invoice_id")
  isAdvance         Boolean  @default(false) @map("is_advance")
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([customerId])
  @@index([projectId])
  @@index([salesInvoiceId])
  @@index([purchaseInvoiceId])
  @@map("payment_records")
}

model InventoryMovement {
  id        String   @id
  kind      String
  detail    String
  productId String?  @map("product_id")
  projectId String?  @map("project_id")
  offerId   String?  @map("offer_id")
  quantity  Int?
  at        String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@index([projectId])
  @@index([createdAt])
  @@map("inventory_movements")
}

model CompanySettings {
  id                    String   @id @default("default")
  companyName           String   @default("ИМФЕКС ЕКСПОРТ-ИМПОРТ ДООЕЛ") @map("company_name")
  address               String   @default("Ул. Качанички Пат бб, Скопје")
  taxId                 String   @default("MK4030012345678") @map("tax_id")
  phone                 String   @default("+389 2 3123 456")
  email                 String   @default("info@imfex.com")
  bankAccount           String?  @map("bank_account")
  defaultAdvancePercent Int      @default(50) @map("default_advance_percent")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  profileId String    @map("profile_id") @db.Uuid
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([profileId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorEmail  String?  @map("actor_email")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

